# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files —— 本项目必须忽略：release 签名私钥 + 密码明文都在这一层
*.jks
*.keystore
*.p12
*.pem
*.key
/keystore.properties
keystore.properties
# 不含密码的模板可以提交
!/keystore.properties.example

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase) —— 含项目凭据，不提交
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
# Capacitor 模板默认忽略它（通常由 `cap sync` 生成）。但本项目不走 cap sync：
# settings.gradle 会 include 这个模块、app/capacitor.build.gradle 会 apply 它里面的
# cordova.variables.gradle，缺失会直接构建失败，所以改为提交。
# 它只有 build.gradle / cordova.variables.gradle / 两个 .gitkeep，没有任何敏感内容；
# 它自己的 build/ 目录仍然被下面的 build/ 规则忽略。
# capacitor-cordova-android-plugins

# Copied web assets —— 由 tools/build-apk.ps1 每次构建前整份重新拷贝，不提交
app/src/main/assets/public

# Generated Config files
# 模板默认忽略这三个（由 cap sync 重新生成）。本项目手工维护它们，且运行时要用到，所以提交：
#   capacitor.config.json   appId / appName / androidScheme（改了才生效）
#   capacitor.plugins.json  原生插件清单（本地插件在 MainActivity 里注册，这里是 []）
#   res/xml/config.xml      Cordova 白名单配置
# app/src/main/assets/capacitor.config.json
# app/src/main/assets/capacitor.plugins.json
# app/src/main/res/xml/config.xml
